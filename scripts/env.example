# Copy to scripts/.env (gitignored), fill every <placeholder>, then:
#   set -a && source scripts/.env && set +a
# Do not commit real tokens.
#
# OpenTofu reads TF_VAR_<terraform_variable_name> only.
# Helm reads STACKGEN_RUNNER_TOKEN / MOTHERSHIP_URL / RUNNER_IMAGE (after apply).
# This root does not create LLM providers or models. Do not set vendor API keys.

# ── Required before tofu apply ──────────────────────────────────────────────

# Guild base URL (no trailing slash). Example: https://aiden.example.com
export TF_VAR_stackgen_url="https://<your-guild-host>"

# Guild personal access token (create agents, runners, vault secrets, integrations).
export TF_VAR_stackgen_token="<guild-personal-access-token>"

# Only if your tenant requires an org/project scope. Otherwise leave commented.
# export TF_VAR_stackgen_project_id="<org-or-project-id>"

# GitLab personal access token. Scopes: read_api (or equivalent).
# Creates Guild GitLab integration + binds its vault secret on the remote runner
# (typed_secret_refs.gitlab) so cce scm describe gets GITLAB_TOKEN after sync.
export TF_VAR_gitlab_token="<gitlab-read-api-token>"

# GitLab origin. Default in terraform is https://gitlab.com if unset.
# export TF_VAR_gitlab_base_url="https://gitlab.com"
# Self-managed:
# export TF_VAR_gitlab_base_url="https://gitlab.example.com"

# ── Required for Helm (after tofu apply) ────────────────────────────────────

# Usually same as TF_VAR_stackgen_url, or:
#   export MOTHERSHIP_URL="$(tofu -chdir=terraform output -raw remote_runner_mothership_url)"
export MOTHERSHIP_URL="$TF_VAR_stackgen_url"

# Paste after apply:
#   export STACKGEN_RUNNER_TOKEN="$(tofu -chdir=terraform output -raw remote_runner_token)"
export STACKGEN_RUNNER_TOKEN="<from-tofu-output-remote_runner_token>"

# Public image — leave as-is unless you rebuilt a custom tag.
export RUNNER_IMAGE="ghcr.io/stackgen-demo/aiden-cce-scm-runner:scm-main"

# Optional Helm targeting:
# export KUBE_CONTEXT="<kubectl-context>"
# export NS="aiden-cce-runner"
